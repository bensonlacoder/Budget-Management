<RCC>
    <qresource prefix="/icons">
        <file alias="chevron-up.png">icons/chevron-up.png</file>
        <file alias="chevron-up@2x.png">icons/chevron-up@2x.png</file>
        <file alias="chevron-down.png">icons/chevron-down.png</file>
        <file alias="chevron-down@2x.png">icons/chevron-down@2x.png</file>
    </qresource>
</RCC>
